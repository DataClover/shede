{
  "pages": [
    "pages/splash/splash",
    "pages/home/home",
    "pages/observe/observe",
    "pages/profile/profile"
  ],
  "subPackages": [
    {
      "root": "packageStorage/",
      "name": "storage",
      "pages": [
        "pages/item-detail/item-detail"
      ]
    },
    {
      "root": "packageCamera/",
      "name": "camera",
      "pages": [
        "pages/camera/camera",
        "pages/item-confirm/item-confirm"
      ]
    },
    {
      "root": "packageShede/",
      "name": "shede",
      "pages": [
        "pages/question/question",
        "pages/verdict/verdict",
        "pages/dispose/dispose"
      ]
    },
    {
      "root": "packageProfile/",
      "name": "profile",
      "pages": [
        "pages/settings/settings",
        "pages/about/about",
        "pages/privacy/privacy",
        "pages/help/help"
      ]
    }
  ],
  "preloadRule": {
    "pages/home/home": {
      "network": "all",
      "packages": ["storage"]
    }
  },
  "window": {
    "backgroundTextStyle": "@backgroundTextStyle",
    "navigationBarBackgroundColor": "@navBackgroundColor",
    "navigationBarTitleText": "舍得",
    "navigationBarTextStyle": "@navTextStyle",
    "backgroundColor": "@backgroundColor",
    "enablePullDownRefresh": false,
    "navigationStyle": "custom"
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "tabBar": {
    "custom": false,
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBackgroundColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "首页",
        "iconPath": "assets/icons/home.png",
        "selectedIconPath": "assets/icons/home-active.png"
      },
      {
        "pagePath": "pages/observe/observe",
        "text": "观察箱"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "assets/icons/profile.png",
        "selectedIconPath": "assets/icons/profile-active.png"
      }
    ]
  },
  "requiredBackgroundModes": [],
  "networkTimeout": {
    "request": 30000,
    "uploadFile": 60000,
    "downloadFile": 60000
  },
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
