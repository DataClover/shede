<cu-custom bgColor="bg-white" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">决策详情</view>
</cu-custom>

<view class="page detail-page">
  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <block wx:else>
    <image wx:if="{{imageUrl}}" class="detail-image" src="{{imageUrl}}" mode="aspectFill"></image>
    <view class="item-card">
      <view class="li-head">
        <view class="item-title">{{item.title}}</view>
        <view class="badge">{{statusText}}</view>
      </view>
      <view class="item-meta">{{item.category || '未分类'}}</view>
      <view class="reason" wx:if="{{item.description}}">{{item.description}}</view>
      <view class="li-sub" wx:if="{{decisionText}}">最终决定：{{decisionText}}</view>
      <view class="li-sub" wx:if="{{item.observe_until}}">观察到期日：{{item.observe_until}}</view>
    </view>

    <view class="item-card" wx:if="{{item.ai_verdict}}">
      <view class="li-head">
        <view class="q-title">AI 建议</view>
        <view><text class="score-big">{{item.ai_score}}</text><text class="score-unit">/100 留</text></view>
      </view>
      <view class="reason">{{item.ai_reason}}</view>
    </view>
    <view class="item-card" wx:else>
      <view class="q-title">还没有分析结论</view>
      <view class="reason">回答四个问题后，这里会展示六维评分和建议理由。</view>
    </view>

    <view class="item-card" wx:if="{{dims.length > 0}}">
      <view class="q-title">六维评分</view>
      <view class="dim-row" wx:for="{{dims}}" wx:key="key">
        <view class="dim-head"><text>{{item.name}}</text><text>{{item.value}}</text></view>
        <view class="dim-bar"><view class="dim-fill" style="width:{{item.value}}%"></view></view>
      </view>
      <view class="foot-note detail-footnote">分数越高越该留；占用空间分越高=越省空间；是否重复当前用“有替代”答案近似。</view>
    </view>

    <button wx:if="{{!item.ai_verdict}}" class="btn-primary" bindtap="onQuestion">去答四问</button>
    <button wx:if="{{item.ai_verdict && item.status === 'pending'}}" class="btn-primary" bindtap="onVerdict">去做最终决定</button>
    <button wx:if="{{item.ai_verdict && item.status !== 'pending'}}" class="btn-primary" bindtap="onVerdict">查看结论</button>
    <button wx:if="{{item.status === 'observing' || item.dispose_channel}}" class="btn-ghost" bindtap="onDispose">查看处理建议</button>
  </block>
</view>
