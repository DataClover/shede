<cu-custom bgColor="bg-white" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">这件东西</view>
</cu-custom>

<view class="page detail-page">
  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <block wx:else>
    <image wx:if="{{imageUrl}}" class="detail-image" src="{{imageUrl}}" mode="aspectFill"></image>
    <view class="item-card">
      <view class="li-head">
        <view class="item-title">{{item.title}}</view>
        <view class="badge">{{statusText}}</view>
      </view>
      <view class="item-meta">{{item.category || '未分类'}}</view>
      <view class="reason" wx:if="{{item.description}}">{{item.description}}</view>
      <view class="li-sub" wx:if="{{decisionText}}">你的决定：{{decisionText}}</view>
      <view class="li-sub" wx:if="{{item.observe_until}}">冷静期到 {{item.observe_until}}</view>
    </view>

    <view class="item-card" wx:if="{{item.ai_verdict}}">
      <view class="li-head">
        <view class="q-title">我是这么想的</view>
        <view><text class="score-big">{{item.ai_score}}</text><text class="score-unit">/100 留</text></view>
      </view>
      <view class="reason">{{item.ai_reason}}</view>
    </view>
    <view class="item-card" wx:else>
      <view class="q-title">还没聊过它</view>
      <view class="reason">回答四个小问题后，这里会展示六维评分和我给的理由。</view>
    </view>

    <view class="item-card" wx:if="{{dims.length > 0}}">
      <view class="q-title">我是从这六个方面看的</view>
      <view class="dim-row" wx:for="{{dims}}" wx:key="key">
        <view class="dim-head"><text>{{item.name}}</text><text>{{item.value}}</text></view>
        <view class="dim-bar"><view class="dim-fill" style="width:{{item.value}}%"></view></view>
      </view>
      <view class="foot-note detail-footnote">分数越高，越偏向留下；「占用空间」分高说明它不占地儿。这些只是我的参考，最后怎么定，听你的。</view>
    </view>

    <button wx:if="{{!item.ai_verdict}}" class="btn-primary" bindtap="onQuestion">一起想想</button>
    <button wx:if="{{item.ai_verdict && item.status === 'pending'}}" class="btn-primary" bindtap="onVerdict">轮到你了</button>
    <button wx:if="{{item.ai_verdict && item.status !== 'pending'}}" class="btn-primary" bindtap="onVerdict">看分析</button>
    <button wx:if="{{item.status === 'observing' || item.dispose_channel}}" class="btn-ghost" bindtap="onDispose">它的下一站</button>
  </block>
</view>
