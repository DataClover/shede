.decision-home {
  padding-bottom: 48rpx;
}

.decision-hero {
  margin-bottom: 24rpx;
}

.camera-button {
  margin-top: 28rpx;
}

.state-grid {
  display: flex;
  align-items: center;
}

.state-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.state-number {
  color: #1f2329;
  font-size: 44rpx;
  font-weight: 700;
}

.state-label,
.section-count,
.decision-note {
  color: #8a9099;
  font-size: 24rpx;
}

.due-card {
  border: 2rpx solid #f2c4bd;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 4rpx 16rpx;
}

.section-title {
  color: #1f2329;
  font-size: 32rpx;
  font-weight: 600;
}

.pending-main {
  flex: 1;
  min-width: 0;
}

.empty-copy {
  margin: 12rpx 0 24rpx;
  text-align: left;
}

.decision-note {
  padding: 32rpx 0 12rpx;
  text-align: center;
}
