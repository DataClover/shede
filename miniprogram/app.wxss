/* app.wxss */

/* 引入ColorUI样式库 */
@import "colorui/main.wxss";
@import "colorui/icon.wxss";
@import "colorui/animation.wxss";
@import "colorui/dark.wxss";

/* 全局基础样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  line-height: 1.6;
}

/* 通用容器样式 */
.container {
  padding: 0 30rpx;
  min-height: 100vh;
}

.page-container {
  padding-top: 20rpx;
  padding-bottom: 40rpx;
}

/* 卡片样式 */
.card {
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-large {
  border-radius: 20rpx;
}

/* 列表项样式 */
.list-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  transition: background-color 0.2s ease;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: white;
  font-size: 36rpx;
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.list-item-subtitle {
  font-size: 26rpx;
}

.list-item-arrow {
  font-size: 24rpx;
}

/* 按钮样式增强 */
.btn-primary {
  border: none;
  border-radius: 12rpx;
  color: white;
  font-weight: 600;
  transition: all 0.3s ease;
}

.btn-primary:active {
  transform: translateY(2rpx);
}

.btn-secondary {
  border-radius: 12rpx;
  font-weight: 500;
}

.btn-fab {
  position: fixed;
  bottom: 120rpx;
  right: 30rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  color: white;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  transition: all 0.3s ease;
}

.btn-fab:active {
  transform: scale(0.95);
}

/* 搜索框样式 */
.search-container {
  padding: 20rpx 30rpx;
}

.search-box {
  display: flex;
  align-items: center;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
}

.search-icon {
  margin-right: 20rpx;
  font-size: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.empty-subtitle {
  font-size: 26rpx;
  line-height: 1.8;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background: rgba(18, 150, 219, 0.1);
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-secondary {
  background: rgba(153, 153, 153, 0.1);
}

/* 骨架屏样式 */
.skeleton {
  background: linear-gradient(90deg, #f2f2f2 25%, #e6e6e6 37%, #f2f2f2 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.skeleton-text {
  height: 32rpx;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
}

.skeleton-title {
  height: 40rpx;
  width: 60%;
  border-radius: 4rpx;
  margin-bottom: 20rpx;
}

.skeleton-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
}

/* 工具类 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  align-items: center;
  justify-content: center;
}

.flex-between {
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.ml-20 {
  margin-left: 20rpx;
}

.mr-20 {
  margin-right: 20rpx;
}

.p-20 {
  padding: 20rpx;
}

.pt-20 {
  padding-top: 20rpx;
}

.pb-20 {
  padding-bottom: 20rpx;
}

.pl-20 {
  padding-left: 20rpx;
}

.pr-20 {
  padding-right: 20rpx;
}


/* 舍得决策层共用样式 */
/* ===== 舍得决策层共用样式（原 packageShede/common.wxss，真机不能跨包 @import，故内联） ===== */
/* packageShede/common.wxss —— 舍得决策层共用样式 */
page { background: #f7f8fa; }

.page { padding: 24rpx 28rpx 60rpx; box-sizing: border-box; }

.hero { padding: 12rpx 4rpx 20rpx; }
.hero-title { font-size: 40rpx; font-weight: 600; color: #1f2329; }
.hero-sub { margin-top: 8rpx; font-size: 26rpx; color: #8a9099; }

.item-card {
  background: #fff; border-radius: 20rpx; padding: 24rpx;
  margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04);
}
.item-title { font-size: 32rpx; font-weight: 600; color: #1f2329; }
.item-meta { margin-top: 8rpx; font-size: 24rpx; color: #8a9099; }

.q-block {
  background: #fff; border-radius: 20rpx; padding: 24rpx;
  margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04);
}
.q-title { font-size: 30rpx; color: #1f2329; font-weight: 500; }
.opts { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.opt {
  padding: 14rpx 26rpx; margin: 0 16rpx 16rpx 0;
  border-radius: 40rpx; background: #f2f3f5; color: #4e5969; font-size: 26rpx;
  border: 2rpx solid transparent;
}
.opt-on { background: #eaf5ee; color: #1a8f4a; border-color: #1a8f4a; font-weight: 600; }

.btn-primary {
  margin-top: 12rpx; background: #1a8f4a; color: #fff;
  border-radius: 48rpx; font-size: 32rpx; line-height: 88rpx; height: 88rpx;
}
.btn-primary[disabled] { background: #a8d5ba; color: #fff; }
.btn-ghost {
  margin-top: 16rpx; background: #fff; color: #1a8f4a;
  border: 2rpx solid #1a8f4a; border-radius: 48rpx;
  font-size: 30rpx; line-height: 84rpx; height: 84rpx;
}
.foot-note { margin-top: 24rpx; text-align: center; font-size: 22rpx; color: #a9b0b8; }
.loading { padding: 80rpx 0; text-align: center; color: #8a9099; font-size: 26rpx; }

/* 六维条 */
.dim-row { margin-top: 18rpx; }
.dim-head { display: flex; justify-content: space-between; font-size: 24rpx; color: #4e5969; }
.dim-bar { margin-top: 8rpx; height: 12rpx; border-radius: 8rpx; background: #eef0f3; overflow: hidden; }
.dim-fill { height: 100%; border-radius: 8rpx; background: #1a8f4a; }
.dim-fill.warn { background: #f0a020; }
.dim-fill.bad { background: #d94a3d; }

/* 结论 */
.verdict-chip {
  display: inline-block; padding: 10rpx 26rpx; border-radius: 40rpx;
  font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx;
}
.chip-keep { background: #eaf5ee; color: #1a8f4a; }
.chip-observe { background: #fdf3e3; color: #b47100; }
.chip-dispose { background: #fdeceb; color: #c0392b; }
.score-big { font-size: 72rpx; font-weight: 700; color: #1f2329; line-height: 1; }
.score-unit { font-size: 24rpx; color: #8a9099; margin-left: 8rpx; }
.reason { margin-top: 16rpx; font-size: 28rpx; color: #4e5969; line-height: 1.6; }

/* 列表 */
.list-item {
  background: #fff; border-radius: 20rpx; padding: 22rpx 24rpx;
  margin-bottom: 18rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04);
}
.li-head { display: flex; align-items: center; justify-content: space-between; }
.li-title { font-size: 30rpx; font-weight: 600; color: #1f2329; }
.li-sub { margin-top: 8rpx; font-size: 24rpx; color: #8a9099; }
.badge { padding: 6rpx 16rpx; border-radius: 30rpx; font-size: 22rpx; background: #eef0f3; color: #4e5969; }
.badge-warn { background: #fdeceb; color: #c0392b; }
.badge-ok { background: #eaf5ee; color: #1a8f4a; }
.li-actions { display: flex; margin-top: 16rpx; }
.li-btn {
  padding: 12rpx 28rpx; margin-right: 16rpx; border-radius: 40rpx;
  font-size: 24rpx; background: #f2f3f5; color: #1f2329;
}
.li-btn-main { background: #1a8f4a; color: #fff; }

.tip-list { margin-top: 12rpx; }
.tip-item { font-size: 26rpx; color: #4e5969; line-height: 1.7; }
.platforms { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.platform { padding: 8rpx 20rpx; margin: 0 14rpx 14rpx 0; border-radius: 30rpx;
  background: #eef4fb; color: #2a6fb0; font-size: 24rpx; }

/* ===== 舍得共用样式结束 ===== */
