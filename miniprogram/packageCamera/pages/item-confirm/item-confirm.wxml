<cu-custom bgColor="bg-white" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">确认物品信息</view>
</cu-custom>

<view class="page-container">
  <view class="image-section">
    <view class="image-container">
      <image src="{{imagePath}}" mode="aspectFit" class="captured-image"></image>
      <view class="image-actions">
        <button class="cu-btn bg-grey sm" bindtap="onRetakePhoto">
          <text class="cuIcon-camerafill"></text> 重拍
        </button>
      </view>
    </view>
  </view>

  <view class="edit-section">
    <view class="section-header">
      <text class="cuIcon-edit text-green"></text>
      <text class="section-title">物品信息</text>
    </view>
    <view class="form-card">
      <view class="form-group">
        <view class="form-item">
          <view class="form-label">名称 <text class="required">*</text></view>
          <input class="form-input" placeholder="请输入物品名称" value="{{itemInfo.name}}" data-field="name" bindinput="onInputChange" maxlength="30" />
        </view>
        <view class="form-item">
          <view class="form-label">描述</view>
          <textarea class="form-textarea" placeholder="请输入物品描述（可选）" value="{{itemInfo.description}}" data-field="description" bindinput="onInputChange" maxlength="100" show-confirm-bar="{{false}}"></textarea>
        </view>
        <view class="form-item">
          <view class="form-label">分类 <text class="required">*</text></view>
          <picker class="form-picker" mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
            <view class="picker-text {{itemInfo.category ? '' : 'placeholder'}}">
              {{itemInfo.category || '请选择分类'}} <text class="cuIcon-right"></text>
            </view>
          </picker>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label">标签</view>
        <view class="selected-tags" wx:if="{{itemInfo.tags.length > 0}}">
          <view class="tag selected" wx:for="{{itemInfo.tags}}" wx:key="*this" data-index="{{index}}" bindtap="onRemoveTag">
            <text>{{item}}</text><text class="cuIcon-close"></text>
          </view>
        </view>
        <view class="common-tags">
          <view class="tag {{itemInfo.tags.includes(item) ? 'disabled' : ''}}" wx:for="{{commonTags}}" wx:key="*this" data-tag="{{item}}" bindtap="onAddTag">{{item}}</view>
        </view>
        <view class="custom-tag-input">
          <input class="tag-input" type="text" placeholder="输入自定义标签" value="{{customTagInput}}" confirm-type="done" bindinput="onCustomTagInput" bindconfirm="onAddCustomTag" maxlength="10" />
        </view>
      </view>
    </view>
  </view>

  <view class="action-buttons">
    <button class="cu-btn bg-gradual-green lg" bindtap="onSubmit" disabled="{{submitting || !itemInfo.name || !itemInfo.category}}" loading="{{submitting}}">
      {{submitting ? '保存中...' : '确认，开始决策'}}
    </button>
  </view>
</view>
