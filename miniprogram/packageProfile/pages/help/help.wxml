<view class="page-container">
  <cu-custom bgColor="bg-white" isBack="{{true}}">
    <view slot="backText">返回</view>
    <view slot="content">使用帮助</view>
  </cu-custom>

  <view class="content-container">
    <view class="help-sections">
      <view class="section-card bg-white" wx:for="{{sections}}" wx:key="id">
        <view class="section-header" bindtap="onToggleSection" data-id="{{item.id}}">
          <view class="section-icon bg-grey"><text class="{{item.icon}} text-white"></text></view>
          <view class="section-title text-black">{{item.title}}</view>
          <view class="section-arrow {{item.expanded ? 'expanded' : ''}}"><text class="cuIcon-down text-gray"></text></view>
        </view>
        <view class="section-content {{item.expanded ? 'show' : ''}}">
          <view class="feature-item" wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this">
            <view class="feature-desc text-gray">{{line}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="support-section bg-white">
      <view class="support-title text-black">演示环境</view>
      <view class="support-desc text-gray">无需真实 AppID 或 AI key；请先启动项目后端，再体验完整决策流程。</view>
    </view>
  </view>
</view>
