<!-- packageShede/pages/question/question.wxml -->
<view class="page">
  <view class="hero">
    <view class="hero-title">先回答几个问题</view>
    <view class="hero-sub">越诚实越好，AI 只负责帮你算，不负责劝你</view>
  </view>

  <view class="item-card" wx:if="{{item.title}}">
    <view class="item-title">{{item.title}}</view>
    <view class="item-meta">{{item.category || '未分类'}} · {{item.description || '没有更多描述'}}</view>
  </view>

  <block wx:if="{{!loading}}">
    <view class="q-block" wx:for="{{questions}}" wx:key="key" wx:for-item="q">
      <view class="q-title">{{index + 1}}. {{q.title}}</view>
      <view class="opts">
        <view
          wx:for="{{q.options}}"
          wx:key="value"
          wx:for-item="opt"
          class="opt {{answers[q.key] === opt.value ? 'opt-on' : ''}}"
          data-key="{{q.key}}"
          data-value="{{opt.value}}"
          bindtap="onPick"
        >{{opt.label}}</view>
      </view>
    </view>

    <button class="btn-primary" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">
      {{submitting ? '分析中...' : '看看该不该留'}}
    </button>
    <view class="foot-note">回答与结论只存在你自己的库里，别人看不到</view>
  </block>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
